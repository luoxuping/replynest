# Create a Mind and Builder API key at https://build.hellominds.ai/docs/get-started/account-setup
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=

# A stable alias binds ReplyNest's persistent conversation to your Mind.
MINDS_CONVERSATION_ALIAS=replynest-community

# Required only after deploying to Vercel: protects the daily autonomous follow-up.
CRON_SECRET=
